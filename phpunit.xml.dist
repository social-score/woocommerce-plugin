<?xml version="1.0"?>
<phpunit bootstrap="tests/php/bootstrap.php" colors="true" convertWarningsToExceptions="true" convertNoticesToExceptions="true" convertDeprecationsToExceptions="true">
	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">tests/php/Unit</directory>
		</testsuite>
	</testsuites>
</phpunit>
