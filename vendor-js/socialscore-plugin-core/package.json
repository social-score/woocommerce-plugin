{
  "name": "@socialscore/plugin-core",
  "version": "0.3.1",
  "description": "Shared SocialScore UI and logic for the WooCommerce and Shopify plugins: API client, store dashboard, Check panel and settings.",
  "type": "module",
  "license": "GPL-2.0-or-later",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/social-score/client.git",
    "directory": "packages/plugin-core"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:smoke": "node smoke/run.mjs"
  },
  "peerDependencies": {
    "@socialscore/ui": ">=0.1.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@socialscore/ui": "0.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "jsdom": "^29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
