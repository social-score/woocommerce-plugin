{
	"name": "socialscore-woocommerce",
	"version": "0.1.0",
	"private": true,
	"license": "GPL-2.0-or-later",
	"description": "Admin screens of the SocialScore for WooCommerce plugin.",
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"test": "wp-scripts test-unit-js --config jest.config.js",
		"typecheck": "tsc --noEmit",
		"gen:messages": "node scripts/gen-messages.mjs node_modules/@socialscore/plugin-core/dist/messages.d.ts includes/class-messages.php",
		"dist": "npm run build && node scripts/dist.mjs"
	},
	"dependencies": {
		"@socialscore/plugin-core": "file:vendor-js/socialscore-plugin-core-0.1.0.tgz",
		"@socialscore/ui": "file:vendor-js/socialscore-ui-0.1.0.tgz",
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"devDependencies": {
		"@types/react": "^18.3.0",
		"@types/react-dom": "^18.3.0",
		"@testing-library/react": "^16.0.0",
		"@wordpress/scripts": "^30.0.0",
		"typescript": "^5.5.0",
		"@types/jest": "^29.5.0",
		"@testing-library/jest-dom": "^6.4.0"
	}
}
